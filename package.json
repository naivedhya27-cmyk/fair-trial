{
  "name": "fairtrial",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "claims": "tsx tools/claim-lint/cli.ts",
    "e2e": "playwright test",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run claims && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.0",
    "idb": "^8.0.4",
    "next": "16.4.3",
    "pngjs": "^7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
